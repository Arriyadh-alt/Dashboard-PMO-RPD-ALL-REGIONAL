# Configuration only. Do not commit a real .env or encrypted/private source file.
RPD_PUBLIC_ORIGIN=https://rpd.example.org
RPD_DATA_PATH=/srv/rpd/current.enc.json
RPD_STATE_DIR=/srv/rpd/state
RPD_DATA_OWNER=
# Set to the actual trusted reverse proxy IP(s), never a wildcard.
FORWARDED_ALLOW_IPS=127.0.0.1
# Never enable RPD_DEV on a public or production host.
